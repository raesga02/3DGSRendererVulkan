#version 450

// Exclusive scan of the per-workgroup histograms:
//  - hist[group*256+b] becomes the group's exclusive offset within bin b
//  - globalEx[b] becomes the global exclusive offset for bin b

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) buffer HistBuffer {
    uint hist[];
};

layout(set = 0, binding = 1, std430) buffer GlobalExBuffer {
    uint globalEx[];
};

layout(set = 0, binding = 2, std430) readonly buffer Args {
    uvec4 args;
};

void main() {
    uint b = gl_GlobalInvocationID.x;
    uint groupCount = args.x;

    uint running = 0u;
    for (uint g = 0u; g < groupCount; ++g) {
        uint idx = g * 256u + b;
        uint val = hist[idx];
        hist[idx] = running;
        running += val;
    }
    globalEx[b] = running;

    memoryBarrierBuffer();
    barrier();

    if (b == 0u) {
        uint acc = 0u;
        for (uint i = 0u; i < 256u; ++i) {
            uint t = globalEx[i];
            globalEx[i] = acc;
            acc += t;
        }
    }
    memoryBarrierBuffer();
}
