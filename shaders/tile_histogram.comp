#version 450

// Per-tile histogram of sorted entries (used to compute tile ranges).

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Keys {
    uint keys[];
};
layout(set = 0, binding = 1, std430) readonly buffer EntryCount {
    uint entryCount;
};
layout(set = 0, binding = 2, std430) buffer TileCounts {
    uint counts[];
};

layout(push_constant) uniform Push {
    uint maxEntries;
    uint depthBits;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.maxEntries || i >= entryCount)
        return;
    uint tileID = keys[i] >> pc.depthBits;
    atomicAdd(counts[tileID], 1u);
}
