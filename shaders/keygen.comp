#version 450

// Computes a 32-bit depth sort key for every Gaussian (far-to-near), culls
// off-screen/behind Gaussians (key = max, so they sort last), counts the
// visible ones, and seeds the value buffer with the identity permutation.

layout(local_size_x = 256) in;

struct Gaussian {
    float position[3];
    float cov3D[6];
    float opacity;
    float sh[48];
};

layout(set = 0, binding = 0) uniform CameraUbo {
    mat4 view;
    mat4 proj;
    vec4 viewport;
    vec4 viewportOrigin;        // x, y offset of the view within the target
    vec4 cameraPos;
} camera;

layout(set = 0, binding = 1, std430) readonly buffer GaussianBuffer {
    Gaussian gaussians[];
};

layout(set = 0, binding = 2, std430) writeonly buffer KeyBuffer {
    uint keys[];
};

layout(set = 0, binding = 3, std430) writeonly buffer ValueBuffer {
    uint values[];
};

layout(set = 0, binding = 4, std430) buffer VisibleCountBuffer {
    uint visibleCount;
};

layout(push_constant) uniform Push {
    uint count;
} pc;

uint floatToSortable(float f) {
    uint u = floatBitsToUint(f);
    return (u & 0x80000000u) != 0u ? ~u : (u | 0x80000000u);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) {
        keys[i] = 0xFFFFFFFFu;
        values[i] = 0u;
        return;
    }

    vec3 p = vec3(gaussians[i].position[0], gaussians[i].position[1], gaussians[i].position[2]);
    vec4 viewPos = camera.view * vec4(p, 1.0);

    // Cull behind/near the camera and well outside the view frustum. The lateral
    // margin (1.5x NDC) keeps large splats that straddle the screen edge.
    vec4 clip = camera.proj * viewPos;
    bool visible = viewPos.z < -0.05 &&
                   abs(clip.x) <= 1.5 * clip.w &&
                   abs(clip.y) <= 1.5 * clip.w;

    if (!visible) {
        keys[i] = 0xFFFFFFFFu;
        values[i] = 0u;
        return;
    }

    keys[i] = floatToSortable(viewPos.z);
    values[i] = i;
    atomicAdd(visibleCount, 1u);
}
