#version 450

// Deterministic, stable scatter for one 4-bit radix digit.
//
// Contiguous per-thread ownership: thread `tid` owns items
// [base + tid*8, base + tid*8 + 8). A per-thread histogram is block-scanned so
// each item's destination follows buffer order, making the sort stable (and so
// frame-to-frame deterministic).

layout(local_size_x = 256) in;

#define BLOCK_SIZE 2048
#define ITEMS 8
#define BINS 16

layout(set = 0, binding = 0, std430) readonly buffer InKeyBuffer {
    uint inKeys[];
};
layout(set = 0, binding = 1, std430) readonly buffer InValueBuffer {
    uint inValues[];
};
layout(set = 0, binding = 2, std430) writeonly buffer OutKeyBuffer {
    uint outKeys[];
};
layout(set = 0, binding = 3, std430) writeonly buffer OutValueBuffer {
    uint outValues[];
};
layout(set = 0, binding = 4, std430) readonly buffer HistBuffer {
    uint hist[];
};
layout(set = 0, binding = 5, std430) readonly buffer GlobalExBuffer {
    uint globalEx[];
};

layout(push_constant) uniform Push {
    uint shift;
} pc;

// sThread[bin * 256 + thread]
shared uint sThread[BINS * 256];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint group = gl_WorkGroupID.x;
    uint base = group * BLOCK_SIZE;

    for (uint i = tid; i < BINS * 256u; i += 256u)
        sThread[i] = 0u;
    barrier();

    // Per-thread histogram of its ITEMS (contiguous ownership).
    for (uint t = 0u; t < ITEMS; ++t) {
        uint digit = (inKeys[base + tid * ITEMS + t] >> pc.shift) & 0xFu;
        atomicAdd(sThread[digit * 256u + tid], 1u);
    }
    barrier();

    // Exclusive scan over threads for each bin (thread b owns column b).
    if (tid < BINS) {
        uint run = 0u;
        for (uint i = 0u; i < 256u; ++i) {
            uint v = sThread[tid * 256u + i];
            sThread[tid * 256u + i] = run;
            run += v;
        }
    }
    barrier();

    // Emit items in order (stable within the thread and across threads).
    for (uint t = 0u; t < ITEMS; ++t) {
        uint idx = base + tid * ITEMS + t;
        uint key = inKeys[idx];
        uint digit = (key >> pc.shift) & 0xFu;

        uint rank = 0u;
        for (uint t2 = 0u; t2 < t; ++t2) {
            uint d2 = (inKeys[base + tid * ITEMS + t2] >> pc.shift) & 0xFu;
            if (d2 == digit)
                ++rank;
        }

        uint pos = globalEx[digit] + hist[group * BINS + digit] + sThread[digit * 256u + tid] + rank;
        outKeys[pos] = key;
        outValues[pos] = inValues[idx];
    }
}
