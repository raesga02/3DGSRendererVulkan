#version 450

// Deterministic, stable scatter for one 8-bit radix digit using warp-level
// match ranking (CUB-style). Warp-major layout: thread `tid`'s item `it` is at
// base + warp*256 + it*32 + lane, so buffer order is (warp, item, lane).
//
// rank = globalEx[d] + blockEx[d]                 (block base)
//      + warpExclusive[warp][d]                    (warps before, all items)
//      + running[warp][d]                          (this warp's earlier items)
//      + peerPrefix                                (earlier lanes, this item)

layout(local_size_x = 256) in;

#define BLOCK_SIZE 2048
#define WARPS 8
#define ITEMS 8
#define BINS 256

layout(set = 0, binding = 0, std430) readonly buffer InKeyBuffer {
    uint inKeys[];
};
layout(set = 0, binding = 1, std430) readonly buffer InValueBuffer {
    uint inValues[];
};
layout(set = 0, binding = 2, std430) writeonly buffer OutKeyBuffer {
    uint outKeys[];
};
layout(set = 0, binding = 3, std430) writeonly buffer OutValueBuffer {
    uint outValues[];
};
layout(set = 0, binding = 4, std430) readonly buffer HistBuffer {
    uint hist[];
};
layout(set = 0, binding = 5, std430) readonly buffer GlobalExBuffer {
    uint globalEx[];
};

layout(push_constant) uniform Push {
    uint shift;
} pc;

shared uint sMatch[WARPS * BINS];        // per-warp match mask, reused per item
shared uint sWarp[BINS * WARPS];         // per (digit, warp) counts -> exclusive offsets
shared uint sRun[WARPS * BINS];          // per-warp running digit counts

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint warp = tid >> 5u;
    uint lane = tid & 31u;
    uint group = gl_WorkGroupID.x;
    uint base = group * BLOCK_SIZE;
    uint laneMaskLt = (1u << lane) - 1u;

    for (uint i = tid; i < WARPS * BINS; i += 256u) {
        sMatch[i] = 0u;
        sRun[i] = 0u;
    }
    for (uint i = tid; i < BINS * WARPS; i += 256u)
        sWarp[i] = 0u;
    barrier();

    // Phase A: per-warp digit counts (over all items).
    for (uint it = 0u; it < ITEMS; ++it) {
        uint idx = base + warp * 256u + it * 32u + lane;
        uint digit = (inKeys[idx] >> pc.shift) & 0xFFu;
        atomicOr(sMatch[warp * BINS + digit], 1u << lane);
        barrier();
        uint mask = sMatch[warp * BINS + digit];
        uint leader = uint(findMSB(mask));
        if (lane == leader)
            atomicAdd(sWarp[digit * WARPS + warp], uint(bitCount(mask)));
        barrier();
        sMatch[warp * BINS + digit] = 0u;
        barrier();
    }
    barrier();

    // Exclusive scan across warps for each digit (thread d owns digit d).
    if (tid < BINS) {
        uint run = 0u;
        for (uint w = 0u; w < WARPS; ++w) {
            uint v = sWarp[tid * WARPS + w];
            sWarp[tid * WARPS + w] = run;
            run += v;
        }
    }
    barrier();

    // Phase C: rank and emit.
    for (uint it = 0u; it < ITEMS; ++it) {
        uint idx = base + warp * 256u + it * 32u + lane;
        uint key = inKeys[idx];
        uint digit = (key >> pc.shift) & 0xFFu;
        atomicOr(sMatch[warp * BINS + digit], 1u << lane);
        barrier();
        uint mask = sMatch[warp * BINS + digit];
        uint peer = uint(bitCount(mask & laneMaskLt));

        uint pos = globalEx[digit] + hist[group * BINS + digit] +
                   sWarp[digit * WARPS + warp] + sRun[warp * BINS + digit] + peer;
        outKeys[pos] = key;
        outValues[pos] = inValues[idx];

        uint leader = uint(findMSB(mask));
        if (lane == leader)
            atomicAdd(sRun[warp * BINS + digit], uint(bitCount(mask)));
        barrier();
        sMatch[warp * BINS + digit] = 0u;
        barrier();
    }
}
