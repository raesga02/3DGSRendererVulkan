#version 450

// Builds the indirect draw command from the visible count produced by keygen.
// Writes a VkDrawIndirectCommand { vertexCount, instanceCount, firstVertex, firstInstance }.

layout(local_size_x = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer VisibleCountBuffer {
    uint visibleCount;
};

layout(set = 0, binding = 1, std430) writeonly buffer IndirectBuffer {
    uvec4 command;
};

void main() {
    command = uvec4(6u, visibleCount, 0u, 0u);
}
