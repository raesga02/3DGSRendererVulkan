#version 450

// Per-workgroup histogram of one 4-bit radix digit (16 buckets).

layout(local_size_x = 256) in;

#define BLOCK_SIZE 2048
#define BINS 16

layout(set = 0, binding = 0, std430) readonly buffer KeyBuffer {
    uint keys[];
};

layout(set = 0, binding = 1, std430) buffer HistBuffer {
    uint hist[];
};

layout(push_constant) uniform Push {
    uint shift;
} pc;

shared uint sHist[BINS];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint group = gl_WorkGroupID.x;

    if (tid < BINS)
        sHist[tid] = 0u;
    barrier();

    uint base = group * BLOCK_SIZE;
    for (uint t = 0u; t < 8u; ++t) {
        uint idx = base + tid * 8u + t;
        uint digit = (keys[idx] >> pc.shift) & 0xFu;
        atomicAdd(sHist[digit], 1u);
    }
    barrier();

    if (tid < BINS)
        hist[group * BINS + tid] = sHist[tid];
}
