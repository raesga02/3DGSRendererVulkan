#version 450

// Exclusive prefix sum of per-tile counts -> tileStart[tileCount + 1].

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer TileCounts {
    uint counts[];
};
layout(set = 0, binding = 1, std430) buffer TileStart {
    uint starts[];
};

layout(push_constant) uniform Push {
    uint tileCount;
} pc;

void main() {
    if (gl_GlobalInvocationID.x != 0u)
        return;
    uint acc = 0u;
    for (uint t = 0u; t < pc.tileCount; ++t) {
        starts[t] = acc;
        acc += counts[t];
    }
    starts[pc.tileCount] = acc;
}
